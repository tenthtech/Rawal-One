# Supabase project API settings. Do not add a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public GA4 identifier. Omit/empty to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-11Q13VK1YX
# Set true only after disabling Enhanced Measurement (all events), Google
# Signals, user-provided data collection and ad personalization in the GA stream.
NEXT_PUBLIC_GA_PRIVACY_READY=false
# Explicit opt-in for analytics tests on development/localhost; leave false hosted.
NEXT_PUBLIC_GA_ALLOW_LOCAL=false
